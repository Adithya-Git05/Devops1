#include <tunables/global>

profile my-apparmor-profile /usr/local/bin/python3.8 flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  deny /etc/** r,
  deny /bin/** x,
  deny /usr/bin/** x,

  /usr/local/bin/python3.8 rix,
  /usr/local/lib/ r,
  /usr/local/lib/** mr,
  /usr/lib/** mr,
  /lib/** mr,
  /app/ rw,
  /app/** rw,

  network,
}
