pipeline {
    agent any

    environment {
        COMPOSE_PROJECT_NAME = 'devops-exercise6'
    }

    stages {
        stage('Install dependencies') {
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/pip install -r requirements.txt
                '''
            }
        }

        stage('Test metrics simulation') {
            steps {
                sh '.venv/bin/python -m unittest discover -s . -p "test_*.py"'
            }
        }

        stage('Build and start monitoring stack') {
            steps {
                sh 'docker compose up -d --build'
            }
        }

        stage('Verify monitoring, alerts, and Grafana') {
            steps {
                sh '.venv/bin/python scripts/verify_stack.py'
            }
        }
    }
}
