pipeline {
    agent any

    environment {
        APP_PORT = '5001'
    }

    stages {
        stage('Build') {
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                sh '.venv/bin/python -m unittest discover -s . -p "test_*.py"'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    mkdir -p "$WORKSPACE/python-app-deploy"
                    cp app.py requirements.txt "$WORKSPACE/python-app-deploy/"
                '''
            }
        }

        stage('Run and Verify Application') {
            steps {
                sh '''
                    set -eu
                    PORT="$APP_PORT" .venv/bin/python \
                      "$WORKSPACE/python-app-deploy/app.py" \
                      > "$WORKSPACE/python-app-deploy/app.log" 2>&1 &
                    app_pid=$!
                    trap 'kill "$app_pid"' EXIT
                    APP_URL="http://127.0.0.1:${APP_PORT}/" \
                      .venv/bin/python scripts/smoke_test.py
                '''
            }
        }
    }
}
